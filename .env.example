# Copy to .env, then append generated secrets:  docker compose run --rm keys >> .env
# (or: pipstream keys >> .env). Never commit .env.

# --- generated by `pipstream keys` -------------------------------------------
# PS_INTENT_SIGNING_KEY=        risk engine only (Ed25519 private, base64)
# PS_INTENT_VERIFY_KEY=         router only (Ed25519 public, base64)
# PS_SECRETS_MASTER_KEYS=       Fernet key(s), newest first, comma-separated
# PS_ADMIN_TOKEN=               bearer token for Core API admin endpoints
# POSTGRES_PASSWORD=
# PS_REDIS_PASSWORD_ADMIN= ... PS_REDIS_PASSWORD_<SERVICE>=  one per service

# --- Telegram (spare account; https://my.telegram.org -> API development tools)
PS_INGESTOR_SOURCE=replay          # replay = sample posts; telethon = live
PS_TELEGRAM_API_ID=
PS_TELEGRAM_API_HASH=

# --- MT5 demo via bridge (compose profile "mt5")
PS_MT5_HOST=mt5-bridge
PS_MT5_PORT=8001
PS_MT5_LOGIN=
PS_MT5_PASSWORD=
PS_MT5_SERVER=

# --- Deriv options demo (API token with Trade scope + your app_id)
PS_DERIV_TOKEN=
PS_DERIV_APP_ID=

# --- Alerts
PS_TELEGRAM_BOT_TOKEN=             # a separate Bot API bot for alerts
PS_SEED_ALERT_CHAT_ID=             # your chat id with that bot
PS_SMTP_URL=
PS_SMTP_FROM=

# --- Billing (later)
PS_BILLING_WEBHOOK_SECRETS=        # e.g. manual:xxxx,paystack:sk_test_xxx

# --- Limits
PS_ROUTER_GLOBAL_MAX_LOT=1.0
PS_API_PORT=8080
