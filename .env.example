# Laravel app settings (src/.env on the server, edited in NanoDeploi -> "Edit .env").
# Infra secrets (DB/Redis passwords, engine keys) live in the SITE-ROOT .env; see
# docker-compose.yml and `docker compose run --rm engine pipstream keys`.
APP_NAME=PipStream
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pips.stream
# Where links in emails point (reset links, welcome). Empty: APP_URL; production never uses localhost or http.
PS_PUBLIC_URL=
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=info

# In docker-compose these are set by the container environment (DB_HOST=postgres, ...)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pipstream
DB_USERNAME=pipstream
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=laravel
REDIS_PASSWORD=

# Email goes through Resend. Set the API key and sender in Admin -> Email (superadmin; stored
# encrypted in the database). These are only the fallback. The from-address must be on a domain
# verified at resend.com/domains.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="alerts@pips.stream"
MAIL_FROM_NAME="PipStream"
RESEND_API_KEY=
# Testing before the domain is verified: send every email to your Resend account address.
RESEND_TEST_TO=

# Superadmin (created by `php artisan migrate`, or `php artisan db:seed --class=SuperadminSeeder --force`).
# Set the password here on the server only; never commit it.
PS_SUPERADMIN_EMAIL=felixkiprono@yahoo.com
PS_SUPERADMIN_PASSWORD=
# Watchdog alerts (workers, engine, MetaTrader offline, error spikes). Empty: PS_SUPERADMIN_EMAIL
PS_ALERT_EMAILS=

# The first N customers to sign up are founding members: free for life with every feature.
PS_FOUNDING_SLOTS=10

# Engine public keys (Laravel can seal secrets to them, never open them)
PS_INTAKE_PUBLIC_KEY=
PS_EXECUTOR_PUBLIC_KEY=
PS_ENGINE_URL=http://engine:8001

# Alerts bot (create with @BotFather; set its webhook to https://pips.stream/webhooks/telegram/<secret>)
PS_TELEGRAM_BOT_TOKEN=
PS_TELEGRAM_BOT_USERNAME=PipStreamBot
PS_TELEGRAM_BOT_WEBHOOK_SECRET=

# Paystack (cards + M-Pesa). Webhook URL: https://pips.stream/webhooks/paystack
PAYSTACK_SECRET_KEY=

# Landing page visitors: location from IP via ipinfo.io (token optional, free 50k/month). PS_GEO_PROVIDER= turns lookups off.
PS_GEO_PROVIDER=ipinfo
PS_IPINFO_TOKEN=
