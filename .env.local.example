# Local development: ONE .env for Laravel and the engine (scripts/dev.sh loads it for both).
# scripts/dev.sh fills APP_KEY and the PS_* keys the first time it runs.
APP_NAME=PipStream
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
LOG_CHANNEL=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=pipstream_dev
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=false
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_USERNAME=
REDIS_PASSWORD=
MAIL_MAILER=log

# ---- Telegram: get these at https://my.telegram.org -> API development tools
PS_TELEGRAM_API_ID=
PS_TELEGRAM_API_HASH=
# Writes "PipStream read a signal: ..." to your own Saved Messages for every post it reads.
PS_INGESTOR_CONFIRM_TO_SAVED=true
# Set to true to use the stand-in Telegram (code 12345) instead of the real one.
PS_INGESTOR_FAKE_TELEGRAM=false

# ---- engine (local: one Redis without users)
PS_ENV=dev
PS_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/pipstream_dev
PS_REDIS_URL=redis://127.0.0.1:56379/0
PS_ENGINE_URL=http://127.0.0.1:8001
PS_INGESTOR_SOURCE=telethon
