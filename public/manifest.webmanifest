{
  "name": "PipStream",
  "short_name": "PipStream",
  "description": "Copy the Telegram trading signals you follow to your broker, automatically.",
  "id": "/app",
  "start_url": "/app?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#060b16",
  "theme_color": "#2563ff",
  "categories": ["finance"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Trades", "url": "/app/trades", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Alerts", "url": "/app/alerts", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
